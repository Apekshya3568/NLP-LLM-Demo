import numpy as np

class SimpleRNN:
    def __init__(self, input_size, hidden_size, output_size):
        self.W = np.random.randn(hidden_size, input_size)
        self.U = np.random.randn(hidden_size, hidden_size)
        self.V = np.random.randn(output_size, hidden_size)

    def step(self, x_t, h_prev):
        h_t = np.tanh(self.W @ x_t + self.U @ h_prev)
        y_t = self.V @ h_t
        return h_t, y_t

# Example
rnn = SimpleRNN(input_size=5, hidden_size=4, output_size=3)

x_seq = [np.random.randn(5), np.random.randn(5), np.random.randn(5)]
h = np.zeros(4)

for x in x_seq:
    h, y = rnn.step(x, h)
    print("Hidden:", h)
    print("Output:", y)
    print("---")








