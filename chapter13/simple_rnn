# Keras: Stacked SimpleRNN Sentiment Classifier
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, SimpleRNN, Dense

# -------------------------------------------------
# 1. Dataset
# -------------------------------------------------
sentences = [
    "i love this movie",
    "this film is great",
    "i hate this movie",
    "this film is terrible"
]
labels = [1, 1, 0, 0]

# -------------------------------------------------
# 2. Tokenizer
# -------------------------------------------------
tokenizer = Tokenizer()
tokenizer.fit_on_texts(sentences)

seqs = tokenizer.texts_to_sequences(sentences)
padded = pad_sequences(seqs, padding="post")

vocab_size = len(tokenizer.word_index) + 1

# -------------------------------------------------
# 3. Stacked RNN Model
# -------------------------------------------------
model = Sequential([
    Embedding(input_dim=vocab_size, output_dim=50),

    SimpleRNN(64, return_sequences=True),  # Layer 1
    SimpleRNN(64),                         # Layer 2 (stacked)

    Dense(2, activation="softmax")
])

model.compile(loss="sparse_categorical_crossentropy",
              optimizer="adam", 
              metrics=["accuracy"])

model.summary()

# -------------------------------------------------
# 4. Train
# -------------------------------------------------
model.fit(padded, labels, epochs=10, batch_size=2)



